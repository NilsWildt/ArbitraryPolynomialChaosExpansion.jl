# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov
.mcp.json
# Files generated by invoking Julia with --track-allocation
*.jl.mem
*.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# Manifest.toml - not committed for packages
Manifest.toml

# macOS
.DS_Store

# Windows
Thumbs.db

# Linux
*~

# Vim swap files
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# User-specific preferences
LocalPreferences.toml

# IDE/Editor
.vscode/
.idea/

# Output directories
output/
plots/

# Claude Code / OMC tooling
.agent/
.claude/
.omc/
CLAUDE.md
AGENTS.md

# Resilio Sync artifacts
*.rsls
.rslsc

# Scratch / non-package material (kept out of the published package).
# NOTE: examples/ is intentionally NOT ignored -- it holds README-referenced
# usage examples (basic_example.jl, ishigami_example.jl, ...). Untracked
# experiment scripts that happen to live in examples/ simply stay untracked.
notebooks/
papers/
scratch/
*.ipynb
